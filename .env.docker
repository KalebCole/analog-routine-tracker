# Docker Compose environment variables
# Copy this to .env.docker and fill in values

# Auth
API_AUTH_TOKEN=change-me-in-production

# Storage
STORAGE_MODE=local
LOCAL_STORAGE_PATH=/data/uploads

# Azure OpenAI (external API — still needed for OCR)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_KEY=your-key-here
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# CORS — comma-separated origins
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Todoist (optional)
# TODOIST_API_TOKEN=

# Postgres password (also used in docker-compose.yml)
POSTGRES_PASSWORD=routine_local
