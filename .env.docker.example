# Docker Compose environment variables
# Copy this to .env.docker and fill in values

# Auth
API_AUTH_TOKEN=your-auth-token-here

# Storage
STORAGE_MODE=local
LOCAL_STORAGE_PATH=/data/uploads

# Azure OpenAI (external API — still needed for OCR)
AZURE_OPENAI_ENDPOINT=https://eastus.api.cognitive.microsoft.com/
AZURE_OPENAI_KEY=your-azure-openai-key-here
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# CORS — comma-separated origins
CORS_ORIGIN=http://localhost:3000,https://kalebs-mac-mini.tail6ac27c.ts.net:8443
FRONTEND_URL=https://kalebs-mac-mini.tail6ac27c.ts.net:8443

# Todoist (optional)
TODOIST_API_TOKEN=your-todoist-token-here

# Postgres password (also used in docker-compose.yml)
POSTGRES_PASSWORD=routine_local

# Next.js public API URL (baked into frontend at build time)
NEXT_PUBLIC_API_URL=https://kalebs-mac-mini.tail6ac27c.ts.net:8443
